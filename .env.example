# ─────────────────────────────────────────────────────────────────────────────
# Environment variables — Agent Farmer / Jaivik Sathi
#
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# `.env.local` and `.env.admin.local` are gitignored — never commit real keys.
# `NEXT_PUBLIC_*` values are exposed to the browser; everything else is
# server-only. Keep the service-role key and admin tokens secret.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (database + auth) ──
# Project URL and public anon key — safe to expose to the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Full database access, bypasses RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Bot protection (Cloudflare Turnstile) ──
# Optional but recommended for a public deploy: protects the auth forms and the
# landing feedback form. Free keys at https://dash.cloudflare.com/?to=/:account/turnstile
# The site key is public; the secret key is server-only. Also enable Turnstile in
# the Supabase dashboard (Auth → Bot & Abuse Protection). See SECURITY.md.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Groq (LLM) ──
# Powers the AI assistant, disease advisory, and market/scheme advice.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Text model for the assistant, crop recommendations, schemes, market advice and
# the disease narrative. Optional — defaults to openai/gpt-oss-120b.
#
# Groq retires models without notice, and when it happens EVERY AI feature fails
# at once with a 404. If that happens, check https://console.groq.com/docs/models
# and set a current id here — no code change or redeploy of the app is needed.
# Avoid openai/gpt-oss-20b (returns empty content, answers via a separate
# reasoning field) and qwen/qwen3.6-27b (leaks <think> blocks into replies).
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Multimodal model for the disease-scanner vision fallback. Optional — defaults to
# qwen/qwen3.6-27b. Groq retires vision models fairly often; if scans start failing
# with a "model_not_found" error, check https://console.groq.com/docs/models and set
# a current multimodal id here rather than editing the code.
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ── News feed ──
# Powers /dashboard/news. All three are optional; the route tries them in order
# GNews → NewsAPI → Groq, and without any of them the feed shows nothing.
#
# GNews.io — the production provider. Free tier (100 req/day, 10 articles each)
# works from a deployed origin. Get one at https://gnews.io/register
GNEWS_API_KEY=your-gnews-key
#
# NewsAPI.org — secondary. Its free plan ONLY serves localhost (401s from a
# deployed domain), so it is dev-only unless you pay. https://newsapi.org/register
NEWS_API_KEY=your-newsapi-key
#
# If neither is set (or both return too little), the feed falls back to
# Groq-generated news, clearly labelled "AI Generated" in the UI, via GROQ_API_KEY.

# ── Sensor readings (ThingSpeak / ESP32) ──
# Live temperature, humidity and soil-moisture from field sensors, shown on the
# dashboard directly under the weather card. All optional — with no channel id
# the panel shows a "no sensor connected" state and nothing breaks.
#
# Each ESP32 node publishes to a ThingSpeak channel (https://thingspeak.com).
# Set the channel id + its Read API Key (Channel → API Keys tab; leave the key
# blank for a public channel), then map which field number (1–8) carries each
# reading. Leave a FIELD blank if that node doesn't measure it.
#
# Node A — e.g. a DHT sensor reporting air temperature + humidity.
THINGSPEAK_CHANNEL_A_ID=
THINGSPEAK_CHANNEL_A_READ_KEY=
THINGSPEAK_CHANNEL_A_FIELD_TEMPERATURE=1
THINGSPEAK_CHANNEL_A_FIELD_HUMIDITY=2
THINGSPEAK_CHANNEL_A_FIELD_SOIL_MOISTURE=3
#
# Node B — optional second node (e.g. a dedicated soil-moisture probe on its own
# channel). Omit entirely if one node already covers all three readings. When a
# metric is mapped by both nodes, Node A wins.
THINGSPEAK_CHANNEL_B_ID=
THINGSPEAK_CHANNEL_B_READ_KEY=
THINGSPEAK_CHANNEL_B_FIELD_TEMPERATURE=
THINGSPEAK_CHANNEL_B_FIELD_HUMIDITY=
THINGSPEAK_CHANNEL_B_FIELD_SOIL_MOISTURE=

# ── Market prices (data.gov.in Agmarknet) ──
# Real daily mandi prices for the Market page & ticker. Without it, the app
# falls back to clearly-labelled "estimated" prices, so this is optional.
# Get a free key at https://data.gov.in/ (register → "My Account" → API key).
DATA_GOV_API_KEY=your-data-gov-in-api-key

# ── Feedback notifications (Resend) ──
# The landing page's feedback form always stores submissions in Supabase. These
# three only control the "someone left feedback" email — without them the form
# still works and still saves, it just tells the visitor "we'll read it soon"
# instead of "the team has been notified", and leaves `notified_at` null so
# un-alerted rows are easy to find:
#     select * from feedback where notified_at is null;
#
# Free tier is 3,000 emails/month with no card. Get a key at
# https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Where the alert goes — your own inbox.
FEEDBACK_NOTIFY_TO=you@gmail.com

# Optional. Defaults to Resend's shared sender, which needs no DNS setup.
# Point this at your own verified domain once you have one.
FEEDBACK_NOTIFY_FROM=Agent Farmer <onboarding@resend.dev>

# ── Disease-detection inference server (optional) ──
# FastAPI server for the hybrid CNN image scanner (see the ml/ folder).
# Only needed if you run the image-based disease detection. Without it the scanner
# still works, but falls back to the (less precise) vision model for every scan.
INFERENCE_URL=http://127.0.0.1:8008

# ─────────────────────────────────────────────────────────────────────────────
# Admin only — used by scripts/db-exec.mjs for running SQL migrations.
# Put these in `.env.admin.local` (also gitignored), NOT in .env.local.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token
SUPABASE_PROJECT_REF=your-project-ref
